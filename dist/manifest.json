{
  "manifest_version": 3,
  "name": "GestureFlow Kontrol",
  "description": "HTML5 videoları, Chrome'da yerel işlenen kamera tabanlı el ve yüz takibiyle kontrol edin.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "GestureFlow Kontrol",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "vendor/mediapipe/wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
